# Secret used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Email of the first administrator account.
ADMIN_EMAIL=
# Password of the first administrator account.
ADMIN_PASSWORD=

# Public hostname the app is served on (e.g. behind a reverse proxy).
# APP_PUBLIC_HOST=chat.example.org
# Path of the install settings file inside the container. If set, the file must exist,
# otherwise startup refuses and the container restart-loops.
# SETTINGS_FILEPATH=/app/data/install-settings.json
# API key protecting the logs endpoints.
# LOGS_API_KEY=
# Base URL of an OpenAI-compatible LLM API.
# OPENAI_BASE_URL=
# API key for the LLM API.
# OPENAI_API_KEY=
# Default LLM model offered to users.
# DEFAULT_LLM_MODEL=openai/gpt-4o-mini
# Image tag that docker compose pulls.
# SPARQL_LLM_VERSION=latest
# Image repository that docker compose pulls.
# SPARQL_LLM_IMAGE=ghcr.io/dsl-unibe-ch/sparql-llm
